{
	email {$ACME_EMAIL}
	admin off
}

{$APP_DOMAIN} {
	encode zstd gzip

	root * /srv

	@legacy_app_query {
		path /
		query app=1
	}
	redir @legacy_app_query /play/?fresh=1 temporary
	redir /login /play/?fresh=1 temporary
	redir /play /play/?fresh=1 temporary

	handle_path /play/* {
		root * /srv/play
		header Cache-Control "no-cache, no-store, must-revalidate"
		try_files {path} /index.html
		file_server
	}

	handle {
		try_files {path} {path}.html /index.html
		file_server
	}

	@app_shell path /play/ /play/index.html /play/flutter_bootstrap.js /play/flutter_service_worker.js /play/version.json
	header @app_shell Cache-Control "no-cache, no-store, must-revalidate"

	@landing path / /index.html /flutter_service_worker.js
	header @landing Cache-Control "no-cache, no-store, must-revalidate"

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://accounts.google.com; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://accounts.google.com https://www.gstatic.com https://connect.facebook.net https://checkout.razorpay.com https://cdn.razorpay.com; worker-src 'self' blob:; connect-src 'self' https://api.chessverseai.com wss://api.chessverseai.com https://accounts.google.com https://www.gstatic.com https://fonts.gstatic.com https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://*.googleusercontent.com https://graph.facebook.com https://connect.facebook.net https://api.razorpay.com https://*.razorpay.com; frame-src https://accounts.google.com https://*.firebaseapp.com https://api.razorpay.com https://*.razorpay.com"
	}
}

www.{$APP_DOMAIN} {
	redir https://{$APP_DOMAIN}{uri} permanent
}

{$API_DOMAIN} {
	encode zstd gzip
	reverse_proxy backend:8080

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
}
