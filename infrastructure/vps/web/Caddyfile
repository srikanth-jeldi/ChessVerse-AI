{
	email {$ACME_EMAIL}
	admin off
}

{$APP_DOMAIN} {
	encode zstd gzip

	root * /srv

	@legacy_app_query {
		path /
		query app=1
	}
	redir @legacy_app_query /play/?fresh=1 temporary
	redir /login /play/?fresh=1 temporary
	redir /play /play/?fresh=1 temporary

	handle_path /play/* {
		root * /srv/play
		header Cache-Control "no-cache, no-store, must-revalidate"
		try_files {path} /index.html
		file_server
	}

	handle {
		try_files {path} {path}.html /index.html
		file_server
	}

	@app_shell path /play/ /play/index.html /play/flutter_bootstrap.js /play/flutter_service_worker.js /play/version.json
	header @app_shell Cache-Control "no-cache, no-store, must-revalidate"

	@landing path / /index.html /flutter_service_worker.js
	header @landing Cache-Control "no-cache, no-store, must-revalidate"

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
}

www.{$APP_DOMAIN} {
	redir https://{$APP_DOMAIN}{uri} permanent
}

{$API_DOMAIN} {
	encode zstd gzip
	reverse_proxy backend:8080

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}
}
