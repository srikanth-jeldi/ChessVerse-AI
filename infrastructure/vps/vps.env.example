# Copy this file to vps.env on the server. Never commit vps.env.
APP_DOMAIN=play.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=admin@example.com
PRIVACY_POLICY_URL=https://play.example.com/privacy
TERMS_URL=https://play.example.com/terms
DATA_DELETION_URL=https://play.example.com/data-deletion

POSTGRES_DB=chessverse
POSTGRES_USER=chessverse
POSTGRES_PASSWORD=replace-with-a-long-random-password

MAIL_USERNAME=your-smtp-account@gmail.com
MAIL_PASSWORD=your-16-character-gmail-app-password
MAIL_FROM=your-smtp-account@gmail.com

# OAuth / store login placeholders. Replace on VPS/CI when Google, Apple, and Meta apps are approved.
GOOGLE_WEB_CLIENT_ID=823774384869-32hoj2oa79ftoe9geq78h4iklcnmd0rl.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=replace-google-android-client-id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=replace-google-ios-client-id.apps.googleusercontent.com
APPLE_SERVICE_ID=com.epitomehub.chessverse.signin
APPLE_REDIRECT_URI=https://api.example.com/api/auth/apple/callback
FACEBOOK_APP_ID=27409411982074524
FACEBOOK_APP_SECRET=replace-with-the-meta-app-secret
FACEBOOK_CLIENT_TOKEN=replace-facebook-client-token
FACEBOOK_GRAPH_VERSION=v26.0

# Direct coin purchases. Keep all provider secrets in this uncommitted VPS file
# or mounted read-only secret files. Leave disabled until each sandbox is ready.
GOOGLE_PLAY_BILLING_ENABLED=false
GOOGLE_PLAY_PACKAGE_NAME=com.epitomehub.chessverse
# The existing Firebase Admin service account may be reused only after you add
# that exact account in Play Console API access with order verification rights.
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=/run/secrets/firebase-service-account.json
APPLE_STOREKIT_ENABLED=false
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=rzp_test_replace
RAZORPAY_KEY_SECRET=replace-with-test-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-a-separate-random-webhook-secret

# Optional conversational coach. Keep the API key only in the VPS vps.env.
AI_COACH_LLM_ENABLED=false
AI_COACH_LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
AI_COACH_LLM_API_KEY=replace-with-server-side-openai-api-key
AI_COACH_LLM_MODEL=gpt-4.1-mini
AI_COACH_LLM_TIMEOUT_SECONDS=8
AI_COACH_LLM_MAX_OUTPUT_TOKENS=220

# Optional rclone destination, for example: b2:chessverse-backups
BACKUP_REMOTE=
# Optional source address for IP-restricted storage tokens. Use the VPS public
# IPv4 when the server also has IPv6 and the token allow-list contains IPv4 only.
BACKUP_RCLONE_BIND=
BACKUP_RETENTION_DAYS=14
# Generate separately: openssl rand -base64 32
ATTACHMENT_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
# age public recipient; keep the matching private identity off the VPS.
BACKUP_AGE_RECIPIENT=age1replace-with-offsite-public-recipient

# Healthchecks.io (or a compatible heartbeat service). Keep these URLs secret.
BACKUP_HEARTBEAT_URL=https://hc-ping.com/replace-with-backup-check-id
APP_HEARTBEAT_URL=https://hc-ping.com/replace-with-app-monitor-check-id
MONITOR_MAX_LOGIN_FAILURES_PER_INTERVAL=25
MONITOR_MAX_LOCKOUTS_PER_INTERVAL=3
MONITOR_MAX_5XX_PER_INTERVAL=10
MONITOR_MAX_RATE_LIMITS_PER_INTERVAL=50
